  {
   "who": "N",
   "say": "In January, one share cost about one hundred twenty eight pounds. By summer, it was over one thousand.",
   "show": {
    "k": "card",
    "label": "South Sea Company share price, 1720",
    "big": "£128 → £1,000",
    "sub": "January to summer"
   }
  },
  {
   "who": "N",
   "say": "Here's the key idea. Buying something just because you think the price will keep rising is called speculation.",
   "show": {
    "k": "scene",
