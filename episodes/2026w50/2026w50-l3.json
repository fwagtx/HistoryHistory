  },
  {
   "who": "N",
   "say": "Later, a famous line was pinned on him: I can calculate the motions of the heavenly bodies, but not the madness of people.",
   "show": {
    "k": "scene",
    "bg": "library",
    "cast": [
     {
      "id": "newton",
