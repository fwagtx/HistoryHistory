  },
  {
   "who": "N",
   "say": "At the official inquiry, he said: I do not believe my head went under the water at all. It may have been wetted, but no more.",
   "show": {
    "k": "quote",
    "text": "I do not believe my head went under the water at all. It may have been wetted, but no more.",
    "who": "Charles Joughin, British Wreck Commissioner's Inquiry, 1912"
   }
  },
  {
   "who": "N",
   "say": "His lifebelt held him up for hours. At dawn, he reached a lifeboat floating on its side, where a cook, Isaac Maynard, recognized him.",
   "show": {
    "k": "scene",
    "bg": "ocean",
    "cast": [
     {
      "id": "maynard",
      "x": 0.6,
      "pose": "point",
