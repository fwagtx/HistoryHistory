      "x": 0.6,
      "s": 0.6
     },
     {
      "k": "moneypile",
      "x": 0.82,
      "s": 0.7,
      "enter": "pop"
     }
    ],
    "stickers": [
     {
      "text": "MONEY PRINTER",
      "at": 0.8,
      "color": "#1F8A4A"
     }
    ]
   }
  },
  {
   "who": "N",
   "say": "But there's still the same amount of bread. So each coin or note buys less and less of it."
  },
