    ],
    "tag": {
     "id": "alexander",
     "text": "King Alexander"
    }
   }
  },
  {
   "who": "N",
   "say": "He'd also secretly married a woman named Aspasia Manos, who wasn't royal, which caused a massive scandal."
  },
  {
   "who": "N",
   "say": "On the second of October, 1920, Alexander was walking his German shepherd, Fritz, on the royal estate at Tatoi, just outside Athens.",
   "show": {
    "k": "scene",
    "bg": "field",
    "cast": [
     {
      "id": "alexander",
      "x": 0.4,
      "pose": "walk",
      "mood": "happy"
     }
    ],
    "cam": "pan"
   }
  },
  {
   "who": "N",
   "say": "Fritz got into a fight with a pet monkey that belonged to the man who looked after the palace vineyards.",
   "show": {
    "k": "scene",
    "bg": "field",
    "cast": [
     {
      "id": "alexander",
      "x": 0.4,
      "pose": "scared",
      "mood": "shock"
     }
    ],
    "stickers": [
     {
      "text": "DOG",
      "at": 0.6,
      "color": "#6A4A2A"
     },
     {
      "text": "VS",
      "at": 1.2,
      "color": "#262322"
