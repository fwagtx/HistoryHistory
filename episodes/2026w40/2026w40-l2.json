      "pose": "hips",
      "mood": "smug"
     }
    ]
   }
  },
  {
   "who": "barbarossa",
   "say": "Wait? I am the Emperor. I will simply go across."
  },
  {
   "who": "N",
   "say": "Accounts differ on exactly what happened next. Some say his horse slipped while he forded the river, others say he went in to cool off.",
   "show": {
    "k": "scene",
