  {
   "who": "hunguard",
   "say": "Boss, maybe slow down on the wine?"
  },
  {
   "who": "attila",
   "say": "Slow down? I am Attila! Nothing in this world can stop me!",
   "show": {
    "k": "scene",
    "bg": "camp",
