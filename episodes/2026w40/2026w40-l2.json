  {
   "who": "N",
   "say": "Then, on the tenth of June, 1190, the army reached the Saleph River."
  },
  {
   "who": "crusader",
   "say": "Your Majesty, the crossing is packed. Maybe we wait a bit?",
   "show": {
    "k": "scene",
    "bg": "sea",
    "cast": [
     {
      "id": "crusader",
      "x": 0.3,
      "pose": "point"
     },
     {
      "id": "barbarossa",
