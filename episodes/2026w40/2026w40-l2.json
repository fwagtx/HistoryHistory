      0.2,
      "rgba(200,60,40,0.35)"
     ]
    ]
   }
  },
  {
   "who": "N",
   "say": "Alexander became king in 1917, at just twenty-three, after the Allies forced his father, Constantine, off the throne.",
   "show": {
