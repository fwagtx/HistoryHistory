     }
    ]
   }
  },
  {
   "who": "N",
   "say": "Bonk.",
   "show": {
    "k": "scene",
    "bg": "field",
    "cast": [
     {
      "id": "aeschylus",
      "x": 0.5,
      "mood": "shock",
