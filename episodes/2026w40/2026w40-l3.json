      -1.5,
      52.6
     ],
     [
      -0.69,
      51.87
     ],
     [
      -0.12,
      51.51
     ]
    ]
   }
  },
  {
   "who": "N",
   "say": "It's carrying bags of used banknotes. A lot of bags."
  },
  {
   "who": "N",
   "say": "Near a bridge in Buckinghamshire, a gang tampered with a signal to show red, and the train stopped.",
   "show": {
    "k": "scene",
    "bg": "night",
    "cast": [
     {
      "id": "robber1",
      "x": 0.3,
      "mood": "smug"
     },
     {
      "id": "robber2",
      "x": 0.65,
      "mood": "smug"
     }
    ],
    "fx": [
     "smoke"
    ],
    "cam": "pan"
   }
  },
  {
   "who": "N",
   "say": "The driver, Jack Mills, was struck on the head and seriously injured. This part is not a caper. A real man paid for it."
  },
  {
   "who": "N",
   "say": "The gang took about two point six million pounds, worth tens of millions today.",
   "show": {
    "k": "card",
    "label": "Taken from the mail train",
    "big": "£2.6 MILLION",
    "sub": "roughly £50 million in today's money, by common estimates",
    "cast": [
     {
      "id": "robber1",
      "x": 0.85,
      "mood": "shock",
      "hold": "moneybag"
     }
    ]
   }
  },
  {
   "who": "N",
   "say": "Then they hid out at Leatherslade Farm and, while they waited, reportedly played Monopoly with real money.",
   "show": {
    "k": "scene",
    "bg": "village",
    "cast": [
     {
      "id": "robber1",
      "x": 0.3,
      "pose": "sit",
      "mood": "happy",
      "hold": "moneybag"
     },
     {
      "id": "robber2",
      "x": 0.7,
      "pose": "sit",
      "mood": "smug"
     }
    ]
   }
  },
  {
   "who": "robber1",
   "say": "I'll buy Mayfair."
  },
  {
   "who": "robber2",
   "say": "With real cash? Go on then.",
   "show": {
    "k": "scene",
    "bg": "village",
    "cast": [
     {
      "id": "robber1",
      "x": 0.3,
      "pose": "sit",
      "mood": "happy"
     },
     {
      "id": "robber2",
      "x": 0.7,
      "pose": "shrug",
      "mood": "smug"
     }
    ],
    "cam": "close",
    "focus": "robber2"
   }
  },
  {
   "who": "N",
   "say": "They cleaned the farm to remove fingerprints. Mostly. Police still found prints on a ketchup bottle and on the Monopoly set.",
   "show": {
    "k": "scene",
    "bg": "courtroom",
    "cast": [
     {
      "id": "robber1",
      "x": 0.3,
      "mood": "shock"
     },
     {
      "id": "robber2",
      "x": 0.7,
      "mood": "scared"
     }
    ],
    "stickers": [
     {
      "text": "OOPS",
      "at": 1.3,
      "color": "#C8302A"
     }
    ]
   }
  },
  {
   "who": "N",
   "say": "Most of the gang were caught, and seven of them got thirty years."
  },
  {
   "who": "N",
   "say": "Ronnie Biggs escaped from prison in 1965 and spent decades on the run, finally ending up in Brazil."
  },
  {
   "who": "N",
   "say": "And of the two point six million, most was never recovered."
  },
  {
   "hold": 2.5,
   "show": {
    "k": "chapter",
    "year": "1971",
    "title": "The Man Who Jumped",
    "bg": "night"
   }
  },
  {
   "who": "N",
   "say": "Now to America. The twenty-fourth of November, 1971. A man in a dark suit buys a plane ticket in Portland, Oregon, as Dan Cooper.",
   "show": {
    "k": "scene",
    "bg": "office",
    "cast": [
     {
      "id": "cooper",
      "x": 0.5,
      "mood": "neutral",
      "pose": "hips"
     }
    ],
    "tag": {
     "id": "cooper",
     "text": "\"Dan Cooper\" (D.B. Cooper)"
    }
   }
  },
  {
   "who": "N",
   "say": "A news mix-up later turned the name into D.B. Cooper, and it stuck."
  },
  {
   "who": "N",
   "say": "On board, he hands flight attendant Florence Schaffner a note. She assumes it's his phone number.",
   "show": {
    "k": "scene",
    "bg": "night",
    "cast": [
     {
      "id": "schaffner",
      "x": 0.3,
      "mood": "smug",
      "hold": "letter"
     },
     {
      "id": "cooper",
      "x": 0.7,
      "mood": "neutral",
      "pose": "sit"
     }
    ],
    "tag": {
     "id": "schaffner",
     "text": "Florence Schaffner"
    }
   }
  },
  {
   "who": "schaffner",
   "say": "Sorry, sir, I don't give out my number."
  },
  {
   "who": "cooper",
   "say": "Miss, you'd better look at that note.",
   "show": {
    "k": "scene",
    "bg": "night",
    "cast": [
     {
      "id": "schaffner",
      "x": 0.3,
      "mood": "shock",
      "hold": "letter"
     },
     {
      "id": "cooper",
      "x": 0.7,
      "mood": "neutral",
      "pose": "sit"
     }
    ],
    "cam": "close",
    "focus": "cooper"
   }
  },
  {
   "who": "N",
   "say": "The note said he had a bomb. He wanted two hundred thousand dollars and four parachutes.",
   "show": {
    "k": "card",
    "label": "Cooper's ransom",
    "big": "$200,000",
    "sub": "paid in twenty-dollar bills, plus four parachutes",
    "cast": [
     {
      "id": "cooper",
      "x": 0.85,
      "mood": "neutral"
     }
    ]
   }
  },
  {
   "who": "N",
   "say": "In Seattle, he let the passengers go, took the money, and had the plane take off again."
  },
  {
   "who": "N",
   "say": "Somewhere over southwest Washington, he lowered the rear stairs and jumped into the cold, rainy night.",
   "show": {
    "k": "scene",
    "bg": "night",
    "cast": [
     {
      "id": "cooper",
      "x": 0.5,
      "mood": "neutral",
      "hold": "moneybag",
      "enter": "drop"
     }
    ],
    "fx": [
     "rain"
    ],
    "cam": "shake"
   }
  },
  {
   "who": "N",
   "say": "And that was it. He was never seen again."
  },
  {
   "who": "N",
   "say": "In 1980, an eight-year-old named Brian Ingram found five thousand eight hundred dollars of the ransom on a Columbia River beach.",
   "show": {
    "k": "scene",
    "bg": "harbor",
    "cast": [
     {
      "id": "ingram",
      "x": 0.5,
      "mood": "shock",
      "hold": "moneybag"
     }
    ],
    "tag": {
     "id": "ingram",
     "text": "Brian Ingram, age 8"
    }
   }
  },
  {
   "who": "N",
   "say": "The serial numbers matched. How the cash got there is still argued about."
  },
  {
   "who": "N",
   "say": "In 2016 the FBI stopped actively investigating. It's often called the only unsolved air hijacking in American history."
  },
  {
   "hold": 2.5,
   "show": {
    "k": "chapter",
    "year": "1983",
    "title": "Oops, All Gold",
    "bg": "vault"
   }
  },
  {
   "who": "N",
   "say": "November the twenty-sixth, 1983, a warehouse near Heathrow Airport, run by the security firm Brink's-Mat.",
   "show": {
    "k": "map",
    "lon": -0.6,
    "lat": 51.5,
    "z0": 3,
    "z1": 4,
    "labels": [
     [
      "Heathrow",
      -0.45,
