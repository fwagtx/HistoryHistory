  },
  {
   "who": "N",
   "say": "Let's rewind. England's Crown Jewels were kept at the Tower of London, right on the Thames.",
   "show": {
    "k": "map",
    "lon": -0.3,
    "lat": 51.5,
    "z0": 3,
    "z1": 4,
    "labels": [
     [
