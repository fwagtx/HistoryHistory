    "areas": [
     [
      -0.45,
      51.47,
      0.15,
      "rgba(212,165,42,.4)"
     ]
    ]
   }
  },
  {
   "who": "N",
   "say": "A gang got into the vault with help from an inside man, a security guard named Anthony Black."
  },
  {
   "who": "N",
   "say": "They'd been told to expect about three million pounds in cash."
  },
  {
   "who": "vaultguy1",
   "say": "Right. Where's the cash?",
   "show": {
    "k": "scene",
    "bg": "vault",
    "cast": [
     {
      "id": "vaultguy1",
      "x": 0.3,
      "mood": "neutral",
      "pose": "think"
     },
     {
      "id": "vaultguy2",
      "x": 0.7,
      "mood": "shock",
      "hold": "goldbar"
     }
    ]
   }
  },
  {
   "who": "vaultguy2",
   "say": "Forget the cash. Look at this!",
   "show": {
    "k": "scene",
    "bg": "vault",
    "cast": [
     {
      "id": "vaultguy1",
      "x": 0.3,
      "mood": "shock"
     },
     {
      "id": "vaultguy2",
      "x": 0.7,
      "mood": "happy",
      "hold": "goldbar",
      "pose": "present"
     }
    ],
    "cam": "close",
    "focus": "vaultguy2",
    "fx": [
     "sparkle"
    ]
   }
  },
  {
   "who": "N",
   "say": "Instead, they found six thousand eight hundred gold bars. About three tonnes. With some diamonds and cash, the haul was worth twenty-six million pounds.",
   "show": {
    "k": "card",
    "label": "What was actually in the vault",
    "big": "3 TONNES",
    "sub": "about 6,800 gold bars; with diamonds and cash, a £26 million haul",
    "cast": [
     {
      "id": "vaultguy2",
      "x": 0.85,
      "mood": "happy",
      "hold": "goldbar"
     }
    ]
   }
  },
  {
   "who": "N",
   "say": "Nobody plans for three tonnes of gold. That's not a getaway car, that's a moving van."
  },
  {
   "who": "N",
   "say": "The inside man was found quickly: his sister lived with one of the robbers. Two ringleaders got twenty-five years each.",
   "show": {
    "k": "scene",
    "bg": "courtroom",
    "cast": [
     {
      "id": "vaultguy1",
      "x": 0.5,
      "mood": "sad"
     }
    ]
   }
  },
  {
   "who": "N",
   "say": "But the gold? Most of it was melted down, sold on, and never recovered."
  },
  {
   "who": "N",
   "say": "A popular British legend says anyone who bought gold jewellery in Britain after 1983 could be wearing Brink's-Mat gold. That's a legend, not a lab result.",
   "show": {
    "k": "scene",
    "bg": "market",
    "cast": [
     {
      "id": "vaultguy2",
      "x": 0.5,
      "mood": "smug",
      "hold": "coin"
     }
    ],
    "stickers": [
     {
      "text": "LEGEND!",
      "at": 1.3,
      "color": "#D4A52A"
     }
    ]
   }
  },
  {
   "hold": 2.5,
   "show": {
    "k": "chapter",
    "year": "1990",
    "title": "The Fake Cops",
    "bg": "city"
   }
  },
  {
   "who": "N",
   "say": "Boston, the early hours of the eighteenth of March, 1990, just after Saint Patrick's Day.",
   "show": {
    "k": "scene",
    "bg": "city",
    "cast": [
     {
      "id": "fakecop",
      "x": 0.4,
      "mood": "neutral"
     }
    ],
    "cam": "pan"
   }
  },
  {
   "who": "N",
   "say": "Two men dressed as police officers buzz the side door of the Isabella Stewart Gardner Museum.",
   "show": {
    "k": "scene",
    "bg": "street",
    "cast": [
     {
      "id": "fakecop",
      "x": 0.3,
      "mood": "neutral",
      "pose": "point"
     },
     {
      "id": "nguard",
      "x": 0.7,
      "mood": "neutral"
     }
    ],
    "tag": {
     "id": "fakecop",
     "text": "Not actually a police officer"
    }
   }
  },
  {
   "who": "fakecop",
   "say": "Police. We're here about a disturbance."
  },
  {
   "who": "nguard",
   "say": "Oh! Come on in, officers.",
   "show": {
    "k": "scene",
    "bg": "street",
    "cast": [
     {
      "id": "fakecop",
      "x": 0.3,
      "mood": "smug"
     },
     {
      "id": "nguard",
      "x": 0.7,
      "mood": "happy",
      "pose": "wave"
     }
    ],
    "cam": "close",
    "focus": "nguard"
   }
  },
  {
   "who": "N",
   "say": "Letting them in broke the rules. Soon both guards on duty were tied up in the basement, unhurt but stuck."
  },
  {
   "who": "N",
   "say": "The thieves spent eighty-one minutes inside and left with thirteen works of art.",
   "show": {
    "k": "card",
    "label": "Time the thieves spent inside",
    "big": "81 MINUTES",
    "sub": "13 works taken, none ever recovered",
    "cast": [
     {
      "id": "fakecop",
      "x": 0.85,
      "mood": "smug"
     }
    ]
   }
  },
  {
   "who": "N",
   "say": "They included Vermeer's The Concert and Rembrandt's only known seascape, The Storm on the Sea of Galilee."
  },
  {
   "who": "N",
   "say": "Altogether, the stolen art is valued at around five hundred million dollars.",
   "show": {
    "k": "scene",
    "bg": "library",
    "cast": [
     {
      "id": "nguard",
      "x": 0.5,
      "mood": "shock"
     }
    ],
    "stickers": [
     {
      "text": "$500 MILLION",
      "at": 1.2,
      "color": "#D4A52A"
     }
    ]
   }
  },
  {
   "who": "N",
   "say": "And here's the eerie part. Isabella Gardner's will said nothing in her galleries could ever be changed."
  },
  {
   "who": "N",
   "say": "So the empty frames still hang on the walls, waiting."
  },
  {
