    ],
    "tag": {
     "id": "blood",
     "text": "Thomas Blood"
    }
   }
  },
  {
   "who": "N",
   "say": "In spring 1671 he came to visit, dressed as a parson, a kind of priest, and made friends with the Edwards family."
  },
  {
   "who": "edwards",
   "say": "Such a kind parson! Do come again.",
   "show": {
    "k": "scene",
    "bg": "palace",
    "cast": [
     {
      "id": "edwards",
      "x": 0.65,
      "mood": "happy"
     },
